{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DSA Revision Tracker",
  "version": "1.1.0",
  "identifier": "com.dsa.revision-tracker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSA Revision Tracker",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "category": "Education",
    "shortDescription": "Spaced repetition tracker for DSA interview prep",
    "longDescription": "Track coding problems with spaced repetition schedules (2d, 7d, 21d, 60d) and review reminders.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
